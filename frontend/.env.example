# Optional Vite settings. Copy to .env.local (ignored by Git) to override.

# Where the dev server proxies /api to. Default: the Flask dev server.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000

# API base URL. Keep the same-origin default; a cross-origin URL would need CORS on Flask.
# VITE_API_BASE_URL=/api/v1
