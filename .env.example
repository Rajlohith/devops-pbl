# NetScope configuration. NetScope reads real environment variables only (it does not
# load .env files itself). To use a local copy:  cp .env.example .env
#   set -a; source .env; set +a
# Never commit .env.

# development | testing | production
NETSCOPE_ENV=development

# Required when NETSCOPE_ENV=production (a long random string).
NETSCOPE_SECRET_KEY=

NETSCOPE_DATABASE_URL=postgresql+psycopg://netscope:netscope@localhost:5432/netscope
NETSCOPE_REDIS_URL=redis://localhost:6379/0

# Defaults to backend/instance/uploads
# NETSCOPE_UPLOAD_FOLDER=
# NETSCOPE_MAX_UPLOAD_BYTES=209715200
# NETSCOPE_MAX_PACKETS=2000000
# NETSCOPE_PACKET_BATCH_SIZE=5000

# Directory of the built Vue app that Flask serves. Defaults to frontend/dist
# (create it with: npm --prefix frontend run build).
# NETSCOPE_FRONTEND_DIST=

# Phase 4 analytics. JSON object overriding anomaly-rule thresholds (applied when a capture is
# analysed); names are listed in backend/app/services/analytics/anomalies.py.
# NETSCOPE_ANOMALY_THRESHOLDS={"port_scan_distinct_ports": 30}
# Seconds a DNS query must stay unanswered (with the capture still running) to be an inferred timeout.
# NETSCOPE_DNS_TIMEOUT_SECONDS=5
